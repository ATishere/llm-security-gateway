# Gateway behavior: shadow reports would-block signals without enforcing them.
GATEWAY_MODE=shadow

# Upstream LLM (chat endpoint returns 503 until a key is configured).
GATEWAY_LLM_BASE_URL=https://api.anthropic.com/v1/messages
GATEWAY_LLM_API_KEY=
GATEWAY_LLM_MODEL=claude-3-5-sonnet-20241022
GATEWAY_LLM_TIMEOUT_SECONDS=60

# Defensive controls.
GATEWAY_MAX_PROMPT_CHARS=32000
GATEWAY_ENABLE_PII=true
GATEWAY_PII_BACKEND=regex
GATEWAY_PII_SCORE_THRESHOLD=0.5
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_LOG_LEVEL=INFO
